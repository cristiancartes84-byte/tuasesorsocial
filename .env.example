# Cuenta de Gmail usada para enviar los correos del formulario de contacto.
# Debe ser la cuenta de Gmail a la que reenvía contacto@tuasesorsocial.cl,
# o cualquier cuenta Gmail válida.
GMAIL_USER=tucuenta@gmail.com

# Contraseña de aplicación de Google (NO la contraseña normal de la cuenta).
# Se genera en: https://myaccount.google.com/apppasswords
# Requiere tener la verificación en 2 pasos activada en la cuenta.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
