<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cambiar Contraseña | Tu Asesor Social</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <%- include('partials/auth-styles') %>
</head>
<body>
    <div class="auth-card auth-card-lg">
        <div class="auth-icon">🔒</div>
        <h1>Crea tu contraseña</h1>
        <p class="subtitle">Por seguridad, debes definir una nueva contraseña antes de continuar</p>

        <% if (error) { %>
            <div class="auth-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/cambiar-password">
            <label for="password">Nueva contraseña</label>
            <input type="password" id="password" name="password" minlength="8" required autofocus>

            <label for="confirmar">Confirmar contraseña</label>
            <input type="password" id="confirmar" name="confirmar" minlength="8" required>

            <button type="submit">Guardar y continuar</button>
        </form>
    </div>
</body>
</html>
