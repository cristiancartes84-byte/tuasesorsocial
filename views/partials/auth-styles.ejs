<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
        font-family: 'Montserrat', -apple-system, sans-serif;
        background: linear-gradient(135deg, #2563eb 0%, #059669 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }
    .auth-card {
        background: white;
        border-radius: 20px;
        padding: 2.5rem 2rem;
        max-width: 420px;
        width: 100%;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }
    .auth-card.auth-card-lg { max-width: 480px; padding: 3rem 2.5rem; }
    .auth-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb 0%, #059669 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        color: white;
        margin: 0 auto 1.25rem;
    }
    .auth-card h1 {
        font-size: 1.5rem;
        color: #1f2937;
        margin-bottom: 0.5rem;
        text-align: center;
    }
    .auth-card .subtitle {
        color: #64748b;
        font-size: 0.9rem;
        text-align: center;
        margin-bottom: 1.75rem;
    }
    .auth-card label {
        display: block;
        font-size: 0.85rem;
        color: #374151;
        margin-bottom: 0.35rem;
        font-weight: 600;
    }
    .auth-card input {
        width: 100%;
        padding: 0.75rem 2.75rem 0.75rem 1rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        font-size: 1rem;
        margin-bottom: 1.25rem;
    }
    .auth-card input:focus {
        outline: none;
        border-color: #2563eb;
    }
    .field-hint { font-size: 0.78rem; color: #94a3b8; margin-top: -0.2rem; margin-bottom: 0.5rem; }
    .password-field { position: relative; }
    .password-field input { padding-right: 2.75rem; }
    /* Especificidad mayor que ".auth-card button" (ancho 100%, padding y
       fondo en gradiente): sin esto, el boton del ojo queda estirado y
       con el mismo fondo que "Guardar", tapando el campo completo. */
    .auth-card .password-toggle {
        position: absolute;
        right: 0.6rem;
        top: 0;
        width: auto;
        height: calc(100% - 1.25rem);
        display: flex;
        align-items: center;
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 0 0.3rem;
    }
    .auth-card .password-toggle svg { width: 19px; height: 19px; }
    /* El atributo "hidden" nativo no es confiable sobre <svg> inline en
       algunos navegadores -- se fuerza explicitamente aqui. */
    .auth-card .password-toggle svg[hidden] { display: none; }
    .auth-card .password-toggle:hover { color: #475569; }
    .auth-card button {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg, #2563eb 0%, #059669 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }
    .auth-card button:hover { opacity: 0.9; }
    .auth-error {
        background: #fee2e2;
        color: #b91c1c;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        font-size: 0.9rem;
        margin-bottom: 1.25rem;
    }
    .auth-back {
        display: block;
        text-align: center;
        margin-top: 1.5rem;
        font-size: 0.85rem;
        color: #64748b;
        text-decoration: none;
    }
</style>
