<div class="modal-overlay" id="modalCambiarPasswordOverlay">
    <div class="modal-card">
        <div class="modal-icon">🔒</div>
        <h3>Cambiar contraseña</h3>
        <p class="modal-subtitle">Por tu seguridad, te recomendamos definir una nueva contraseña periódicamente.</p>
        <form id="formCambiarPassword">
            <label for="mcpPassword">Nueva contraseña</label>
            <input type="password" id="mcpPassword" name="password" minlength="8" required autocomplete="new-password">

            <label for="mcpConfirmar">Confirmar contraseña</label>
            <input type="password" id="mcpConfirmar" name="confirmar" minlength="8" required autocomplete="new-password">

            <div class="form-error" id="mcpError" hidden></div>

            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" id="mcpCancelar">Cancelar</button>
                <button type="submit" class="btn">Guardar</button>
            </div>
        </form>
        <div id="mcpExito" hidden>✅ Contraseña actualizada correctamente.</div>
    </div>
</div>

<script>
    (function () {
        var overlay = document.getElementById('modalCambiarPasswordOverlay');
        var form = document.getElementById('formCambiarPassword');
        var errorBox = document.getElementById('mcpError');
        var exito = document.getElementById('mcpExito');
        if (!overlay || !form) return;

        function abrir(e) {
            if (e) e.preventDefault();
            form.hidden = false;
            form.reset();
            exito.hidden = true;
            errorBox.hidden = true;
            overlay.classList.add('open');
        }
        function cerrar() {
            overlay.classList.remove('open');
        }

        document.querySelectorAll('[data-abrir-cambiar-password]').forEach(function (el) {
            el.addEventListener('click', abrir);
        });
        document.getElementById('mcpCancelar').addEventListener('click', cerrar);
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) cerrar();
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            errorBox.hidden = true;
            fetch('/cambiar-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    password: document.getElementById('mcpPassword').value,
                    confirmar: document.getElementById('mcpConfirmar').value,
                }),
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.ok) {
                        form.hidden = true;
                        exito.hidden = false;
                        setTimeout(cerrar, 1500);
                    } else {
                        errorBox.textContent = data.error || 'No se pudo cambiar la contraseña.';
                        errorBox.hidden = false;
                    }
                })
                .catch(function () {
                    errorBox.textContent = 'Error de conexión. Intenta nuevamente.';
                    errorBox.hidden = false;
                });
        });
    })();
</script>
