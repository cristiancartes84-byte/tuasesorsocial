<div class="modal-overlay" id="modalCambiarPasswordOverlay">
    <div class="modal-card">
        <div class="modal-icon">🔒</div>
        <h3>Cambiar contraseña</h3>
        <p class="modal-subtitle">Por tu seguridad, te recomendamos definir una nueva contraseña periódicamente.</p>
        <form id="formCambiarPassword">
            <label for="mcpPassword">Nueva contraseña</label>
            <p class="field-hint">Mínimo 8 caracteres.</p>
            <div class="password-field">
                <input type="password" id="mcpPassword" name="password" minlength="8" required autocomplete="new-password">
                <button type="button" class="password-toggle" data-target="mcpPassword" aria-label="Mostrar contraseña">
                    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="icon-eye-off" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a18.49 18.49 0 0 1 4.22-5.19M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 7 11 7a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
                </button>
            </div>

            <label for="mcpConfirmar">Confirmar contraseña</label>
            <div class="password-field">
                <input type="password" id="mcpConfirmar" name="confirmar" minlength="8" required autocomplete="new-password">
                <button type="button" class="password-toggle" data-target="mcpConfirmar" aria-label="Mostrar contraseña">
                    <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="icon-eye-off" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a18.49 18.49 0 0 1 4.22-5.19M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 7 11 7a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
                </button>
            </div>

            <div class="form-error" id="mcpError" hidden></div>

            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" id="mcpCancelar">Cancelar</button>
                <button type="submit" class="btn">Guardar</button>
            </div>
        </form>
        <div id="mcpExito" hidden>✅ Contraseña actualizada correctamente.</div>
    </div>
</div>

<script>
    (function () {
        var overlay = document.getElementById('modalCambiarPasswordOverlay');
        var form = document.getElementById('formCambiarPassword');
        var errorBox = document.getElementById('mcpError');
        var exito = document.getElementById('mcpExito');
        if (!overlay || !form) return;

        function abrir(e) {
            if (e) e.preventDefault();
            form.hidden = false;
            form.reset();
            exito.hidden = true;
            errorBox.hidden = true;
            overlay.classList.add('open');
        }
        function cerrar() {
            overlay.classList.remove('open');
        }

        document.querySelectorAll('[data-abrir-cambiar-password]').forEach(function (el) {
            el.addEventListener('click', abrir);
        });
        // Se usa setAttribute/removeAttribute en vez de la propiedad .hidden:
        // en algunos navegadores esa propiedad no refleja el atributo en
        // elementos <svg> inline, y el icono nunca cambiaria al hacer clic.
        function alternarIcono(svg, mostrar) {
            if (mostrar) svg.removeAttribute('hidden');
            else svg.setAttribute('hidden', '');
        }
        overlay.querySelectorAll('.password-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.target);
                var esOculta = input.type === 'password';
                input.type = esOculta ? 'text' : 'password';
                alternarIcono(btn.querySelector('.icon-eye'), !esOculta);
                alternarIcono(btn.querySelector('.icon-eye-off'), esOculta);
                btn.setAttribute('aria-label', esOculta ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        });
        document.getElementById('mcpCancelar').addEventListener('click', cerrar);
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) cerrar();
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            errorBox.hidden = true;
            fetch('/cambiar-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    password: document.getElementById('mcpPassword').value,
                    confirmar: document.getElementById('mcpConfirmar').value,
                }),
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.ok) {
                        form.hidden = true;
                        exito.hidden = false;
                        setTimeout(cerrar, 1500);
                    } else {
                        errorBox.textContent = data.error || 'No se pudo cambiar la contraseña.';
                        errorBox.hidden = false;
                    }
                })
                .catch(function () {
                    errorBox.textContent = 'Error de conexión. Intenta nuevamente.';
                    errorBox.hidden = false;
                });
        });
    })();
</script>
