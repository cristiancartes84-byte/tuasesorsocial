<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= caso.cliente_nombre %> — <%= caso.tipo_subsidio %> | Tu Asesor Social</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <%- include('../partials/app-styles') %>
    <style>
        .inf-estado { display: inline-block; font-size: 0.74rem; font-weight: 700; padding: 0.22rem 0.65rem; border-radius: 100px; }
        .inf-estado.borrador { background: #dbeafe; color: #1e40af; }
        .inf-estado.cambios_solicitados { background: #fef3c7; color: #92400e; }
        .inf-estado.aprobado { background: #d1fae5; color: #065f46; }
        .inf-estado.oficial { background: #065f46; color: #fff; }
        .inf-estado.reemplazado { background: #f1f5f9; color: #64748b; }
        .inf-fila { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap; padding: 0.7rem 0; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem; }
        .inf-fila:last-child { border-bottom: none; }
        .inf-fila a { font-weight: 600; }
        .inf-coment { font-size: 0.84rem; color: #475569; background: #f8fafc; border-radius: 10px; padding: 0.6rem 0.8rem; margin-top: 0.35rem; white-space: pre-wrap; }
        .inf-aviso { border-radius: 12px; padding: 0.85rem 1.1rem; font-size: 0.88rem; line-height: 1.5; margin-bottom: 1rem; }
        .inf-aviso.ok { background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; font-weight: 600; }
        .inf-aviso.info { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; }
        .inf-destacado { border: 2px solid #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12); }
        .inf-opciones { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 0.9rem 0; }
        .inf-opciones label { flex: 1 1 220px; display: flex !important; flex-direction: row !important; align-items: center; gap: 0.6rem; margin: 0 !important; padding: 0.75rem 1rem; border: 1.5px solid #e2e8f0; border-radius: 12px; cursor: pointer; font-weight: 600; font-size: 0.9rem; }
        .inf-opciones input[type=radio] { width: 18px !important; min-width: 18px; height: 18px; padding: 0 !important; margin: 0 !important; flex: 0 0 18px; }
        .inf-opciones label:has(input:checked) { border-color: #2563eb; background: #eff6ff; }
        .inf-confirma { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 0.9rem 1rem; margin-bottom: 0.8rem; }
        .inf-confirma p { font-size: 0.82rem; color: #64748b; margin-bottom: 0.5rem; }
    </style>
</head>
<body>
    <header class="app-header">
        <div class="app-header-title">
            <%- include('../partials/brand-mark') %>
            <h1><%= caso.cliente_nombre %> (<%= caso.cliente_rut %>)</h1>
            <span class="app-header-subtitle">
                <%= caso.tipo_subsidio %> &middot;
                <span class="presence-dot<%= clienteEnLinea ? ' online' : '' %>"></span>
                <%= clienteEnLinea ? 'Cliente en línea' : 'Cliente desconectado' %>
            </span>
        </div>
        <div class="admin-topbar-right">
            <a href="/admin/dashboard">&larr; Volver al panel</a>
            <%- include('../partials/admin-topbar') %>
        </div>
    </header>
    <main class="app-main">
        <div class="card">
            <h2><%= caso.tipo_subsidio %></h2>
            <p style="color: #64748b; font-size: 0.9rem;">Caso creado el <%= formatearFecha(caso.creado_en) %></p>
            <p style="margin-top: 0.75rem;">Estado actual:
                <span class="badge<%= caso.estado_actual === 'Aprobado' ? ' badge-aprobado' : caso.estado_actual === 'Rechazado' ? ' badge-rechazado' : '' %>">
                    <%= caso.estado_actual %>
                </span>
            </p>

            <form class="stacked" method="POST" action="/admin/casos/<%= caso.id %>/hito">
                <label for="hito">Actualizar hito</label>
                <select id="hito" name="hito" required>
                    <% hitos.forEach(function (h) { %>
                        <option value="<%= h %>" <%= h === caso.estado_actual ? 'selected' : '' %>><%= h %></option>
                    <% }); %>
                </select>
                <button type="submit" class="btn">Guardar hito y notificar al cliente</button>
            </form>
        </div>

        <div class="card" id="informe">
            <h2>Informe para el cliente</h2>
            <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1rem;">
                Tipo de informe: <strong><%= caso.tipo_subsidio %></strong>. Sube primero un <strong>borrador en PDF</strong>: el sistema le estampa la marca de agua "TU ASESOR SOCIAL" en todas las páginas y se lo muestra al cliente para que lo revise. Cuando el cliente da su visto bueno, subes el informe oficial firmado.
            </p>
            <% if (informeError) { %><div class="form-error"><%= informeError %></div><% } %>
            <% if (informeOk) { %><div class="inf-aviso ok">✅ <%= informeOk %></div><% } %>

            <% if (oficial) { %>
                <div class="inf-aviso ok">✅ El informe oficial firmado ya fue entregado al cliente.</div>
            <% } %>

            <% if (versionesInforme.length === 0 && !oficial) { %>
                <div class="empty-state">Todavía no has subido ningún borrador para este caso.</div>
            <% } else { %>
                <% if (oficial) { %>
                    <div class="inf-fila">
                        <span>📄 <a href="/admin/informes/<%= oficial.id %>/descargar" target="_blank" rel="noopener">Informe oficial — <%= oficial.nombre_original %></a>
                            <span class="meta" style="color:#64748b;font-size:0.8rem;">· <%= formatearFecha(oficial.creado_en) %></span></span>
                        <span class="inf-estado oficial">Oficial firmado</span>
                    </div>
                <% } %>
                <% versionesInforme.forEach(function (v) { %>
                    <div class="inf-fila" style="display:block;">
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:0.75rem;flex-wrap:wrap;">
                            <span>📝 <a href="/admin/informes/<%= v.id %>/descargar" target="_blank" rel="noopener">Borrador versión <%= v.version %></a>
                                <span class="meta" style="color:#64748b;font-size:0.8rem;">· <%= formatearFecha(v.creado_en) %></span></span>
                            <span class="inf-estado <%= v.estado %>"><%= v.estado === 'borrador' ? 'Esperando al cliente' : v.estado === 'cambios_solicitados' ? 'Cliente pidió cambios' : v.estado === 'aprobado' ? 'Aprobado por el cliente' : 'Reemplazado por versión nueva' %></span>
                        </div>
                        <% if (v.comentario_cliente) { %><div class="inf-coment"><strong>Comentario del cliente:</strong> <%= v.comentario_cliente %></div><% } %>
                        <% if (v.estado === 'aprobado' && v.respondido_en) { %>
                            <div class="meta" style="color:#047857;font-size:0.8rem;margin-top:0.3rem;">Visto bueno confirmado con RUT y contraseña el <%= formatearFecha(v.respondido_en) %> (RUT <%= v.rut_confirmacion %>).</div>
                        <% } %>
                    </div>
                <% }); %>
            <% } %>

            <% if (!oficial) { %>
                <form class="stacked" method="POST" action="/admin/casos/<%= caso.id %>/informe/borrador" enctype="multipart/form-data" style="margin-top: 1.1rem;">
                    <label for="informeBorrador"><%= borrador ? 'Subir una nueva versión del borrador' : 'Subir borrador del informe' %> (PDF, máx. 15 MB)</label>
                    <input type="file" id="informeBorrador" name="informe" accept="application/pdf,.pdf" required>
                    <button type="submit" class="btn">Subir borrador con marca de agua y avisar al cliente</button>
                </form>

                <% if (borrador && borrador.estado === 'aprobado') { %>
                    <form class="stacked" method="POST" action="/admin/casos/<%= caso.id %>/informe/oficial" enctype="multipart/form-data" style="margin-top: 1.4rem; padding-top: 1.1rem; border-top: 1px solid #e2e8f0;" onsubmit="return confirm('Se entregará al cliente el informe oficial tal como está (sin marca de agua). ¿Continuar?');">
                        <label for="informeOficial">El cliente dio su visto bueno: sube el informe oficial firmado con firma electrónica (PDF, máx. 15 MB)</label>
                        <input type="file" id="informeOficial" name="informe" accept="application/pdf,.pdf" required>
                        <button type="submit" class="btn">Entregar informe oficial al cliente</button>
                    </form>
                <% } else if (borrador) { %>
                    <p style="margin-top: 1rem; font-size: 0.84rem; color: #94a3b8;">El informe oficial se podrá subir cuando el cliente dé su visto bueno a la última versión del borrador.</p>
                <% } %>
            <% } %>
        </div>

        <div class="card">
            <h2>Historial de hitos</h2>
            <% var stepperHistorial = historial.slice().reverse(); %>
            <div class="stepper">
                <% stepperHistorial.forEach(function (item, i) { %>
                    <div class="stepper-item<%= i === stepperHistorial.length - 1 ? ' is-active' : '' %>">
                        <%- include('../partials/stepper-icon', { hito: item.hito, isCurrent: i === stepperHistorial.length - 1 }) %>
                        <div class="stepper-card">
                            <div class="hito"><%= item.hito %></div>
                            <div class="meta"><%= item.creado_por_nombre %> — <%= formatearFecha(item.creado_en) %></div>
                            <% if (historial.length > 1) { %>
                                <form class="stepper-card-actions" method="POST" action="/admin/casos/<%= caso.id %>/hitos/<%= item.id %>/eliminar" onsubmit="return confirm('¿Eliminar este hito del historial? Si es el más reciente, el estado actual del caso volverá al hito anterior.');">
                                    <button type="submit" class="btn-delete">Eliminar</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>

        <div class="card">
            <h2>Agregar nota / Solicitar documentos</h2>
            <form class="stacked" method="POST" action="/admin/casos/<%= caso.id %>/nota">
                <textarea name="texto" placeholder="Mensaje para el cliente (opcional; puedes dejarlo vacío si solo vas a solicitar documentos)"></textarea>
                <div class="checkbox-row">
                    <input type="checkbox" id="visible_para_cliente" name="visible_para_cliente" checked>
                    <label for="visible_para_cliente" style="margin: 0;">Visible para el cliente (le llegará un aviso por correo)</label>
                </div>
                <div class="checkbox-row">
                    <input type="checkbox" id="requiere_respuesta" name="requiere_respuesta">
                    <label for="requiere_respuesta" style="margin: 0;">Necesito que el cliente responda con un comentario</label>
                </div>

                <label>Solicitar documentos (opcional, puedes marcar varios)</label>
                <% tiposDocumento.forEach(function (tipo) { %>
                    <div class="checkbox-row">
                        <input type="checkbox" id="tipo_<%= tipo.id %>" name="tipo_documento" value="<%= tipo.id %>">
                        <label for="tipo_<%= tipo.id %>" style="margin: 0;"><%= tipo.label %><%= tipo.cantidad > 1 ? ' (' + tipo.cantidad + ' archivos)' : '' %></label>
                    </div>
                <% }); %>

                <div id="tipo_otro_detalle_wrap" style="display: none;">
                    <label for="tipo_otro_detalle">¿Qué documento es?</label>
                    <input type="text" id="tipo_otro_detalle" name="tipo_otro_detalle" placeholder="Ej: Contrato de arriendo vigente">
                </div>

                <button type="submit" class="btn">Guardar</button>
            </form>
        </div>

        <div class="card">
            <h2>Solicitudes de documentos</h2>
            <% if (solicitudes.length === 0) { %>
                <div class="empty-state">Todavía no se ha solicitado ningún documento en este caso.</div>
            <% } else { %>
                <% solicitudes.forEach(function (solicitud) { %>
                    <% var validos = solicitud.documentos.filter(function (d) { return d.estado_revision !== 'rechazado'; }).length; %>
                    <% var porcentaje = Math.round((validos / solicitud.cantidad_requerida) * 100); %>
                    <div class="solicitud-card<%= solicitud.estado === 'completada' ? ' is-completa' : '' %>">
                        <div class="solicitud-header">
                            <div class="solicitud-icon"><%= solicitud.estado === 'completada' ? '✅' : '📎' %></div>
                            <div class="solicitud-title">
                                <strong><%= solicitud.tipo_label %></strong>
                                <span class="meta">Solicitado el <%= formatearFecha(solicitud.creado_en) %></span>
                            </div>
                            <div class="solicitud-actions">
                                <span class="badge<%= solicitud.estado === 'completada' ? ' badge-aprobado' : '' %>">
                                    <%= solicitud.estado === 'completada' ? 'Completa' : 'Pendiente' %>
                                </span>
                                <% if (solicitud.documentos.length === 0) { %>
                                    <form method="POST" action="/admin/casos/<%= caso.id %>/solicitudes/<%= solicitud.id %>/eliminar" onsubmit="return confirm('¿Eliminar esta solicitud de documento?');">
                                        <button type="submit" class="btn-delete">Eliminar</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>

                        <div class="progress-track"><div class="progress-fill" style="width: <%= porcentaje %>%;"></div></div>
                        <span class="progress-label"><%= validos %> de <%= solicitud.cantidad_requerida %> recibido(s)</span>

                        <% if (solicitud.documentos.length > 0) { %>
                            <ul class="file-list">
                                <% solicitud.documentos.forEach(function (doc) { %>
                                    <li class="file-chip file-chip-review">
                                        <span>📄 <a href="/admin/documentos/<%= doc.id %>/descargar">Documento <%= doc.numero_slot %> — <%= doc.nombre_original %></a>
                                        <span class="doc-status-badge <%= doc.estado_revision %>"><%= doc.estado_revision === 'aprobado' ? '✓ Correcto' : doc.estado_revision === 'rechazado' ? '✗ Debe actualizar' : 'Sin revisar' %></span></span>
                                        <span class="file-chip-actions">
                                            <% if (doc.estado_revision !== 'aprobado') { %>
                                                <form method="POST" action="/admin/documentos/<%= doc.id %>/revision">
                                                    <input type="hidden" name="estado" value="aprobado">
                                                    <button type="submit" class="btn-mini btn-mini-ok">✓ Correcto</button>
                                                </form>
                                            <% } %>
                                            <% if (doc.estado_revision !== 'rechazado') { %>
                                                <form method="POST" action="/admin/documentos/<%= doc.id %>/revision">
                                                    <input type="hidden" name="estado" value="rechazado">
                                                    <button type="submit" class="btn-mini btn-mini-reject">✗ Debe actualizar</button>
                                                </form>
                                            <% } %>
                                        </span>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } %>
                    </div>
                <% }); %>
            <% } %>
        </div>

        <div class="card">
            <h2>Notas</h2>
            <% if (notas.length === 0) { %>
                <div class="empty-state">Todavía no hay notas en este caso.</div>
            <% } else { %>
                <% notas.forEach(function (nota) { %>
                    <div class="nota-card<%= !nota.visible_para_cliente ? ' solo-interna' : '' %>">
                        <% if (nota.autor_foto) { %>
                            <img class="nota-avatar" src="/avatars/<%= nota.autor_foto %>" alt="<%= nota.autor_nombre %>" style="object-fit: cover;">
                        <% } else { %>
                            <div class="nota-avatar">👤</div>
                        <% } %>
                        <div class="nota-body">
                            <div class="nota-header">
                                <strong><%= nota.autor_nombre %></strong>
                                <span class="meta"><%= formatearFecha(nota.creado_en) %></span>
                                <% if (!nota.visible_para_cliente) { %><span class="meta">· solo interna</span><% } %>
                            </div>
                            <% if (nota.requiere_respuesta || nota.requiere_documento) { %>
                                <div class="nota-badges">
                                    <% if (nota.requiere_respuesta) { %><span class="requiere-badge">Pidió respuesta</span><% } %>
                                    <% if (nota.requiere_documento) { %><span class="requiere-badge">Pidió documento</span><% } %>
                                </div>
                            <% } %>
                            <div class="nota-bubble"><%= nota.texto %></div>

                            <% if (nota.respuestas.length > 0) { %>
                                <div class="nota-replies">
                                    <% nota.respuestas.forEach(function (respuesta) { %>
                                        <div class="nota-reply">
                                            <div class="meta"><%= respuesta.usuario_nombre %> — <%= formatearFecha(respuesta.creado_en) %></div>
                                            <div class="texto"><%= respuesta.texto %></div>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else if (nota.requiere_respuesta) { %>
                                <p style="margin-top: 0.6rem; font-size: 0.82rem; color: #94a3b8;">Esperando respuesta del cliente.</p>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>

        <div class="card">
            <h2>Comentarios generales del cliente</h2>
            <p style="color: #64748b; font-size: 0.85rem; margin-bottom: 0.75rem;">Comentarios que no responden a una pregunta puntual (esas aparecen debajo de la nota correspondiente, arriba).</p>
            <% if (respuestas.length === 0) { %>
                <div class="empty-state">El cliente todavía no ha dejado un comentario general.</div>
            <% } else { %>
                <% respuestas.forEach(function (respuesta) { %>
                    <div class="respuesta-card">
                        <div class="meta"><%= respuesta.usuario_nombre %> — <%= formatearFecha(respuesta.creado_en) %></div>
                        <div class="texto"><%= respuesta.texto %></div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </main>
    <script>
        var tipoOtroCheckbox = document.getElementById('tipo_otro');
        if (tipoOtroCheckbox) {
            tipoOtroCheckbox.addEventListener('change', function () {
                document.getElementById('tipo_otro_detalle_wrap').style.display = this.checked ? 'block' : 'none';
            });
        }
    </script>
</body>
</html>
