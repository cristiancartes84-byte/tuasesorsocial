<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Trabajadora Social | Tu Asesor Social</title>
    <meta name="robots" content="noindex, nofollow">
    <%- include('../partials/auth-styles') %>
</head>
<body>
    <div class="auth-card">
        <h1>Panel de Gestión</h1>
        <p class="subtitle">Acceso para trabajador social</p>

        <% if (error) { %>
            <div class="auth-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/login">
            <label for="rut">RUT</label>
            <input type="text" id="rut" name="rut" placeholder="12345678-9" required autofocus>

            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required>

            <button type="submit">Ingresar</button>
        </form>

        <a href="/" class="auth-back">&larr; Volver al sitio</a>
    </div>
</body>
</html>
