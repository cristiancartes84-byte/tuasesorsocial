<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Gestión | Tu Asesor Social</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <%- include('../partials/app-styles') %>
</head>
<body>
    <header class="app-header">
        <div class="app-header-title">
            <%- include('../partials/brand-mark') %>
            <h1>Panel de Gestión</h1>
        </div>
        <div class="admin-topbar-right">
            <%- include('../partials/admin-topbar') %>
        </div>
    </header>
    <main class="app-main">
        <div class="toolbar">
            <a href="/admin/clientes/nuevo" class="btn">+ Nuevo cliente</a>
            <a href="/admin/casos/nuevo" class="btn btn-secondary">+ Nuevo caso</a>
            <a href="/admin/clientes" class="btn btn-secondary">Administrar clientes</a>
            <a href="/admin/citas" class="btn btn-secondary">Citas agendadas</a>
            <a href="/admin/disponibilidad" class="btn btn-secondary">Mi disponibilidad</a>
            <a href="/admin/perfil" class="btn btn-secondary">Mi perfil</a>
        </div>

        <div class="card">
            <h2>Casos</h2>
            <% if (casos.length === 0) { %>
                <div class="empty-state">Todavía no hay casos registrados.</div>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>RUT</th>
                            <th>Tipo de gestión</th>
                            <th>Estado actual</th>
                            <th>Creado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% casos.forEach(function (caso) { %>
                            <tr class="clickable" onclick="window.location.href='/admin/casos/<%= caso.id %>'">
                                <td><%= caso.cliente_nombre %></td>
                                <td><%= caso.cliente_rut %></td>
                                <td><%= caso.tipo_subsidio %></td>
                                <td>
                                    <span class="badge<%= caso.estado_actual === 'Aprobado' ? ' badge-aprobado' : caso.estado_actual === 'Rechazado' ? ' badge-rechazado' : '' %>">
                                        <%= caso.estado_actual %>
                                    </span>
                                </td>
                                <td><%= formatearFecha(caso.creado_en) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </main>
</body>
</html>
