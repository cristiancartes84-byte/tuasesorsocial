<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agenda | Tu Asesor Social</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <%- include('../partials/app-styles') %>
    <%- include('../partials/dashboard-styles') %>
    <style>
        .cal-wrap { display: grid; grid-template-columns: minmax(280px, 340px) 1fr; gap: 1.5rem; align-items: start; }
        @media (max-width: 760px) { .cal-wrap { grid-template-columns: 1fr; } }
        .cal { border: 1px solid #e2e8f0; border-radius: 16px; padding: 1rem; background: #fff; }
        .cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
        .cal-head strong { font-size: 0.98rem; color: #1f2937; text-transform: capitalize; }
        .cal-nav { width: 32px; height: 32px; border-radius: 50%; border: none; background: #f1f5f9; color: #334155; cursor: pointer; font-size: 1.1rem; line-height: 1; }
        .cal-nav:hover:not(:disabled) { background: #e2e8f0; }
        .cal-nav:disabled { opacity: 0.3; cursor: default; }
        .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; text-align: center; }
        .cal-dow { font-size: 0.7rem; font-weight: 700; color: #94a3b8; padding: 0.3rem 0; text-transform: uppercase; }
        .cal-day {
            aspect-ratio: 1; border: none; background: none; border-radius: 50%; font: inherit; font-size: 0.85rem;
            color: #cbd5e1; cursor: default; position: relative; display: flex; align-items: center; justify-content: center;
        }
        .cal-day.libre { color: #1d4ed8; font-weight: 700; background: #eff6ff; cursor: pointer; }
        .cal-day.libre:hover { background: #dbeafe; }
        .cal-day.hoy:not(.sel) { box-shadow: inset 0 0 0 2px #93c5fd; }
        .cal-day.sel { background: linear-gradient(135deg, #2563eb 0%, #059669 100%); color: #fff; font-weight: 700; }
        .cal-leyenda { font-size: 0.74rem; color: #94a3b8; margin-top: 0.7rem; display: flex; gap: 0.9rem; flex-wrap: wrap; }
        .cal-leyenda i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #dbeafe; margin-right: 0.3rem; vertical-align: -1px; }

        .cal-slots h3 { font-size: 1rem; color: #1f2937; text-transform: capitalize; margin-bottom: 0.15rem; }
        .cal-slots .sub { font-size: 0.8rem; color: #64748b; margin-bottom: 0.9rem; }
        .slot-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 0.5rem; }
        .slot-chip {
            padding: 0.6rem 0.4rem; border-radius: 12px; border: 1.5px solid #dbeafe; background: #fff; cursor: pointer;
            font: inherit; font-size: 0.9rem; font-weight: 700; color: #2563eb; text-align: center;
        }
        .slot-chip small { display: block; font-size: 0.68rem; font-weight: 500; color: #94a3b8; margin-top: 0.1rem; }
        .slot-chip:hover { background: #eff6ff; border-color: #2563eb; }
        .slot-chip.sel { background: linear-gradient(135deg, #2563eb 0%, #059669 100%); color: #fff; border-color: transparent; }
        .slot-chip.sel small { color: rgba(255,255,255,0.85); }

        .resumen {
            display: none; margin-top: 1.25rem; padding: 1.1rem 1.2rem; border-radius: 16px;
            background: #f8fafc; border: 1.5px solid #bfdbfe;
        }
        .resumen.activo { display: block; }
        .resumen-top { display: flex; gap: 0.9rem; align-items: center; margin-bottom: 0.9rem; flex-wrap: wrap; }
        .resumen-fecha { font-size: 1.05rem; font-weight: 800; color: #1f2937; text-transform: capitalize; }
        .resumen-det { font-size: 0.82rem; color: #64748b; }
        .resumen-badge { margin-left: auto; font-size: 0.8rem; font-weight: 700; color: #92400e; background: #fef3c7; padding: 0.25rem 0.7rem; border-radius: 100px; }
        .reserva-form { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #f1f5f9; }
        .reserva-form label { display: block; font-weight: 700; font-size: 0.9rem; color: #1f2937; margin-bottom: 0.4rem; }
        .reserva-form textarea {
            width: 100%; min-height: 96px; padding: 0.75rem 0.9rem; border: 1.5px solid #e2e8f0;
            border-radius: 12px; font: inherit; font-size: 0.9rem; resize: vertical; color: #1f2937; background: #fff;
        }
        .reserva-form textarea:focus { outline: none; border-color: #2563eb; }
        .reserva-ayuda { font-size: 0.78rem; color: #94a3b8; margin: 0.3rem 0 1rem; }
        .abono-aviso {
            background: #fffbeb; border: 1px solid #fde68a; color: #92400e;
            border-radius: 12px; padding: 0.85rem 1rem; font-size: 0.85rem; margin-bottom: 1rem; line-height: 1.5;
        }
        .btn-reservar {
            border: none; cursor: pointer; font: inherit; font-weight: 700; font-size: 0.95rem; color: #fff;
            padding: 0.8rem 1.6rem; border-radius: 12px; background: linear-gradient(135deg, #2563eb 0%, #059669 100%);
        }
        .btn-reservar:disabled { opacity: 0.5; cursor: not-allowed; }

        .cita-card { border: 1px solid #e2e8f0; border-radius: 14px; padding: 1rem 1.1rem; margin-bottom: 0.9rem; background: #fff; }
        .cita-card:last-child { margin-bottom: 0; }
        .cita-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
        .cita-estado { display: inline-block; padding: 0.2rem 0.65rem; border-radius: 100px; font-size: 0.72rem; font-weight: 700; margin-top: 0.35rem; }
        .cita-estado.ok { background: #d1fae5; color: #065f46; }
        .cita-estado.espera { background: #fef3c7; color: #92400e; }
        .cita-estado.revision { background: #dbeafe; color: #1e40af; }
        .cita-motivo { font-size: 0.82rem; color: #64748b; margin-top: 0.5rem; }
        .pago-box { background: #f8fafc; border-radius: 12px; padding: 0.9rem 1rem; margin-top: 0.9rem; }
        .pago-box h3 { font-size: 0.9rem; color: #1f2937; margin-bottom: 0.2rem; }
        .pago-box p.small { font-size: 0.8rem; color: #64748b; margin-bottom: 0.7rem; }
        .pago-dato { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 0.35rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.85rem; }
        .pago-dato:last-of-type { border-bottom: none; }
        .pago-dato span { color: #64748b; }
        .pago-dato strong { color: #1f2937; word-break: break-all; text-align: right; }
        .btn-copiar { border: none; background: #e0e7ff; color: #3730a3; border-radius: 8px; font: inherit; font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.55rem; cursor: pointer; margin-left: 0.4rem; }
        .btn-pagado { margin-top: 0.8rem; border: none; cursor: pointer; font: inherit; font-weight: 700; font-size: 0.88rem; color: #fff; padding: 0.65rem 1.2rem; border-radius: 10px; background: #059669; }
        .pago-nota { font-size: 0.78rem; color: #92400e; margin-top: 0.6rem; }
        .srv-select { width: 100%; max-width: 420px; padding: 0.7rem 0.9rem; border: 1.5px solid #e2e8f0; border-radius: 12px; font: inherit; font-size: 0.92rem; font-weight: 600; color: #1f2937; background: #fff; }
        .srv-select:focus { outline: none; border-color: #2563eb; }
        .srv-label { display: block; font-weight: 700; font-size: 0.9rem; color: #1f2937; margin-bottom: 0.4rem; }
        .srv-info { font-size: 0.83rem; color: #64748b; margin: 0.6rem 0 1.25rem; }
        .aviso-cierre { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 12px; padding: 0.9rem 1.1rem; font-size: 0.88rem; line-height: 1.5; }
        .cuenta-regresiva { display: flex; align-items: center; gap: 0.6rem; background: #fef3c7; color: #92400e; border-radius: 12px; padding: 0.6rem 0.9rem; margin-bottom: 0.7rem; font-size: 0.85rem; font-weight: 600; }
        .cuenta-regresiva .tiempo { font-size: 1.3rem; font-weight: 800; font-variant-numeric: tabular-nums; }
        .cita-card.destacada { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.18); }
    </style>
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/portal-sidebar', { activo: 'agenda' }) %>

        <div class="app-content">
            <div class="dash-header-row">
                <div class="dash-header">
                    <%- include('../partials/brand-mark', { dark: true }) %>
                    <div class="dash-title">Agenda</div>
                    <p class="dash-subtitle">Reserva una hora con tu trabajadora social o revisa tus horas ya agendadas.</p>
                </div>
                <div class="dash-header-actions">
                    <% if (trabajadorSocial) { %><%- include('../partials/portal-topbar') %><% } %>
                    <%- include('../partials/portal-mi-cuenta') %>
                </div>
            </div>

            <% var citaReservada = reservado ? misCitas.find(function (c) { return String(c.id) === String(reservado); }) : null; %>
            <% if (citaReservada && citaReservada.estado === 'confirmada') { %>
                <div class="success-banner">✅ Tu hora quedó confirmada. Te enviamos un correo con los detalles.</div>
            <% } else if (citaReservada) { %>
                <div class="success-banner">✅ Tu hora está reservada por <%= minutosRetencion %> minutos. Realiza la transferencia del abono (datos abajo) y pulsa “Ya hice la transferencia”. Tu trabajadora social confirmará el pago y la hora quedará tuya.</div>
            <% } %>
            <% if (pagoInformado) { %>
                <div class="success-banner">✅ Avisamos que ya transferiste. Tu trabajadora social revisará el pago y te confirmará la hora por correo.</div>
            <% } %>
            <% if (error) { %>
                <div class="form-error"><%= error %></div>
            <% } %>

            
            <% { %>
                <% if (misCitas.length > 0) { %>
                    <div class="panel" style="margin-bottom: 1.5rem;">
                        <div class="panel-header">
                            <h2>Tus próximas horas</h2>
                        </div>
                        <% misCitas.forEach(function (cita) { %>
                            <div class="cita-card<%= cita.estado === 'pendiente_pago' && cita.pago_estado === 'pendiente' ? ' destacada' : '' %>" id="cita-<%= cita.id %>">
                                <div class="cita-card-top">
                                    <div class="cita-info">
                                        <strong><%= formatearDiaLargo(cita.fecha_inicio) %>, <%= formatearHora(cita.fecha_inicio) %></strong>
                                        <span><%= cita.servicio || cita.tipo_subsidio || 'Gestión' %> · <%= cita.duracion_minutos %> min</span><br>
                                        <% if (cita.estado === 'confirmada') { %>
                                            <span class="cita-estado ok">✓ Confirmada<%= cita.pago_estado === 'recibido' ? ' · abono recibido' : '' %></span>
                                        <% } else if (cita.pago_estado === 'informado') { %>
                                            <span class="cita-estado revision">Pago informado · en revisión</span>
                                        <% } else { %>
                                            <span class="cita-estado espera">Esperando abono</span>
                                        <% } %>
                                    </div>
                                    <% if (cita.pago_estado !== 'recibido') { %>
                                        <form method="POST" action="/portal/agenda/<%= cita.id %>/cancelar" onsubmit="return confirm('¿Cancelar esta hora agendada?');">
                                            <button type="submit" class="btn-delete">Cancelar</button>
                                        </form>
                                    <% } %>
                                </div>
                                <% if (cita.motivo) { %>
                                    <div class="cita-motivo"><strong>Tu consulta:</strong> <%= cita.motivo %></div>
                                <% } %>

                                <% if (cita.estado === 'pendiente_pago') { %>
                                    <div class="pago-box">
                                        <% if (cita.pago_estado === 'pendiente') { %>
                                            <div class="cuenta-regresiva" data-expira="<%= cita.expira_en.replace(' ', 'T') %>Z">⏱ Tu hora está retenida por <span class="tiempo">--:--</span></div>
                                            <h3>Transfiere el abono de <%= formatearPesos(cita.monto_reserva) %> para confirmar</h3>
                                            <p class="small">Es el 50% del valor de la sesión (<%= formatearPesos(cita.monto_total) %>); el resto se paga en la sesión. Usa este código como comentario de la transferencia.</p>
                                        <% } else { %>
                                            <h3>Recibimos tu aviso de transferencia</h3>
                                            <p class="small">Tu trabajadora social verificará que el abono (<%= formatearPesos(cita.monto_reserva) %>) haya llegado y confirmará tu hora. Te avisaremos por correo.</p>
                                        <% } %>
                                        <% [['Banco', config.banco], ['Tipo de cuenta', config.tipo_cuenta], ['N° de cuenta', config.numero_cuenta], ['Titular', config.titular], ['RUT', config.rut_titular], ['Correo', config.email_pago]].forEach(function (d) { if (d[1]) { %>
                                            <div class="pago-dato"><span><%= d[0] %></span><div><strong><%= d[1] %></strong><button type="button" class="btn-copiar" data-copiar="<%= d[1] %>">Copiar</button></div></div>
                                        <% } }); %>
                                        <div class="pago-dato"><span>Monto</span><div><strong><%= formatearPesos(cita.monto_reserva) %></strong></div></div>
                                        <div class="pago-dato"><span>Comentario</span><div><strong>CITA-<%= cita.id %></strong><button type="button" class="btn-copiar" data-copiar="CITA-<%= cita.id %>">Copiar</button></div></div>
                                        <% if (cita.pago_estado === 'pendiente') { %>
                                            <form method="POST" action="/portal/agenda/<%= cita.id %>/informar-pago">
                                                <button type="submit" class="btn-pagado">Ya hice la transferencia</button>
                                            </form>
                                            <p class="pago-nota">Si no pulsas el botón dentro del tiempo indicado, el horario se libera para otras personas.</p>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                <% } %>

                <div class="panel">
                    <div class="panel-header">
                        <h2>Agendar una nueva hora</h2>
                    </div>

                    <% if (reservaHabilitada) { %>
                        <label class="srv-label" for="servicioSel">¿Qué servicio necesitas?</label>
                        <select id="servicioSel" class="srv-select" onchange="location.href='/portal/agenda?servicio=' + encodeURIComponent(this.value)">
                            <% servicios.forEach(function (sv) { %>
                                <option value="<%= sv %>"<%= sv === servicioSeleccionado ? ' selected' : '' %>><%= sv %></option>
                            <% }); %>
                        </select>
                        <p class="srv-info">
                            Sesión de <strong><%= duracion %> minutos</strong><% if (montos.total > 0) { %> · valor <strong><%= formatearPesos(montos.total) %></strong><% } %>
                            <% if (montos.requiereAbono) { %> · para reservar abonas el <strong>50% (<%= formatearPesos(montos.reserva) %>)</strong> por transferencia<% } else { %> · <strong>sin abono previo</strong>: la hora queda confirmada al reservar<% } %>.
                            Elige un día y una hora (hora de Santiago de Chile):
                        </p>
                    <% } %>

                    <% if (!reservaHabilitada) { %>
                        <div class="aviso-cierre">
                            La reserva en línea todavía no está habilitada. Escríbele a tu trabajadora social por WhatsApp para coordinar tu hora.
                        </div>
                    <% } else if (diasConSlots.length === 0) { %>
                        <div class="empty-state">
                            Tu trabajadora social todavía no tiene horarios disponibles publicados. Contáctala por WhatsApp si necesitas agendar.
                        </div>
                    <% } else { %>
                        <%
                            var datosAgenda = {
                                hoy: hoyClave,
                                dias: diasConSlots.map(function (d) {
                                    return {
                                        clave: d.clave,
                                        etiqueta: formatearDiaLargo(d.fecha),
                                        slots: d.slots.map(function (sl) {
                                            return { iso: sl.inicio.toISOString(), hora: formatearHora(sl.inicio), fin: formatearHora(sl.fin) };
                                        })
                                    };
                                })
                            };
                        %>
                        <script type="application/json" id="agendaData"><%- JSON.stringify(datosAgenda).replace(/</g, '\\u003c') %></script>

                        <div class="cal-wrap">
                            <div class="cal">
                                <div class="cal-head">
                                    <button type="button" class="cal-nav" id="calPrev" aria-label="Mes anterior">&lsaquo;</button>
                                    <strong id="calTitulo"></strong>
                                    <button type="button" class="cal-nav" id="calNext" aria-label="Mes siguiente">&rsaquo;</button>
                                </div>
                                <div class="cal-grid" id="calGrid"></div>
                                <div class="cal-leyenda"><span><i></i>Días con horas disponibles</span></div>
                            </div>
                            <div class="cal-slots">
                                <h3 id="slotsTitulo"></h3>
                                <p class="sub" id="slotsSub"></p>
                                <div class="slot-grid" id="slotGrid"></div>
                            </div>
                        </div>

                        <form method="POST" action="/portal/agenda/reservar" id="formReserva" class="resumen">
                            <input type="hidden" name="servicio" value="<%= servicioSeleccionado %>">
                            <input type="hidden" name="inicio" id="inicioInput" value="">
                            <div class="resumen-top">
                                <div>
                                    <div class="resumen-fecha" id="resFecha"></div>
                                    <div class="resumen-det" id="resDet"></div>
                                </div>
                                <% if (montos.requiereAbono) { %>
                                    <span class="resumen-badge">Abono 50%: <%= formatearPesos(montos.reserva) %></span>
                                <% } else { %>
                                    <span class="resumen-badge" style="background: #d1fae5; color: #065f46;">Sin abono previo</span>
                                <% } %>
                            </div>
                            <div class="reserva-form" style="margin-top: 0; padding-top: 0; border-top: none;">
                                <label for="detalle">Cuéntanos tus dudas o qué quieres lograr con la asesoría <span style="font-weight: 500; color: #94a3b8;">(opcional)</span></label>
                                <textarea id="detalle" name="detalle" maxlength="500" placeholder="Ej: quiero postular al subsidio y no sé qué documentos necesito."><%= detalle %></textarea>
                                <p class="reserva-ayuda">Así ella puede preparar la sesión. Máximo 500 caracteres.</p>

                                <% if (montos.requiereAbono) { %>
                                    <div class="abono-aviso">
                                        💳 Al pulsar <strong>Reservar</strong> te mostraremos los datos para transferir el abono de <strong><%= formatearPesos(montos.reserva) %></strong> (50% de <%= formatearPesos(montos.total) %>). Tu hora quedará <strong>pendiente por <%= minutosRetencion %> minutos</strong>; cuando tu trabajadora social confirme que recibió la transferencia, la hora queda confirmada y tomada para ti.
                                    </div>
                                    <button type="submit" class="btn-reservar">Reservar y ver datos de transferencia</button>
                                <% } else { %>
                                    <button type="submit" class="btn-reservar">Reservar hora</button>
                                <% } %>
                            </div>
                        </form>

                        <script>
                        (function () {
                            var datos = JSON.parse(document.getElementById('agendaData').textContent);
                            var duracion = <%= duracion %>;
                            var porClave = {};
                            datos.dias.forEach(function (d) { porClave[d.clave] = d; });
                            var primera = datos.dias[0].clave.split('-');
                            var mes = { y: +primera[0], m: +primera[1] };
                            var ultima = datos.dias[datos.dias.length - 1].clave.split('-');
                            var mesMin = { y: +primera[0], m: +primera[1] };
                            var mesMax = { y: +ultima[0], m: +ultima[1] };
                            var seleccionDia = null, seleccionSlot = null;
                            var NOMBRES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
                            var DOW = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];

                            var grid = document.getElementById('calGrid');
                            var titulo = document.getElementById('calTitulo');
                            var prev = document.getElementById('calPrev');
                            var next = document.getElementById('calNext');
                            var slotGrid = document.getElementById('slotGrid');
                            var form = document.getElementById('formReserva');

                            function pad(n) { return (n < 10 ? '0' : '') + n; }
                            function cmp(a, b) { return (a.y - b.y) * 12 + (a.m - b.m); }

                            function pintarMes() {
                                titulo.textContent = NOMBRES[mes.m - 1] + ' ' + mes.y;
                                prev.disabled = cmp(mes, mesMin) <= 0;
                                next.disabled = cmp(mes, mesMax) >= 0;
                                grid.innerHTML = '';
                                DOW.forEach(function (d) { var e = document.createElement('div'); e.className = 'cal-dow'; e.textContent = d; grid.appendChild(e); });
                                var primero = new Date(mes.y, mes.m - 1, 1);
                                var offset = (primero.getDay() + 6) % 7;
                                var diasMes = new Date(mes.y, mes.m, 0).getDate();
                                for (var i = 0; i < offset; i++) grid.appendChild(document.createElement('div'));
                                for (var d = 1; d <= diasMes; d++) {
                                    var clave = mes.y + '-' + pad(mes.m) + '-' + pad(d);
                                    var b = document.createElement('button');
                                    b.type = 'button';
                                    b.textContent = d;
                                    b.className = 'cal-day';
                                    if (porClave[clave]) { b.className += ' libre'; b.setAttribute('data-clave', clave); }
                                    else b.disabled = true;
                                    if (clave === datos.hoy) b.className += ' hoy';
                                    if (clave === seleccionDia) b.className += ' sel';
                                    grid.appendChild(b);
                                }
                            }

                            function pintarSlots() {
                                var dia = porClave[seleccionDia];
                                document.getElementById('slotsTitulo').textContent = dia.etiqueta;
                                document.getElementById('slotsSub').textContent = dia.slots.length + (dia.slots.length === 1 ? ' hora disponible' : ' horas disponibles') + ' · sesión de ' + duracion + ' min · hora de Santiago';
                                slotGrid.innerHTML = '';
                                dia.slots.forEach(function (sl) {
                                    var b = document.createElement('button');
                                    b.type = 'button';
                                    b.className = 'slot-chip' + (sl.iso === seleccionSlot ? ' sel' : '');
                                    b.setAttribute('data-iso', sl.iso);
                                    b.innerHTML = sl.hora + '<small>hasta ' + sl.fin + '</small>';
                                    slotGrid.appendChild(b);
                                });
                            }

                            function elegirDia(clave) {
                                seleccionDia = clave;
                                var p = clave.split('-');
                                mes = { y: +p[0], m: +p[1] };
                                if (seleccionSlot && !porClave[clave].slots.some(function (s) { return s.iso === seleccionSlot; })) {
                                    seleccionSlot = null;
                                    form.classList.remove('activo');
                                    document.getElementById('inicioInput').value = '';
                                }
                                pintarMes();
                                pintarSlots();
                            }

                            function elegirSlot(iso) {
                                seleccionSlot = iso;
                                var dia = porClave[seleccionDia];
                                var sl = dia.slots.filter(function (s) { return s.iso === iso; })[0];
                                document.getElementById('inicioInput').value = iso;
                                document.getElementById('resFecha').textContent = dia.etiqueta + ', ' + sl.hora;
                                document.getElementById('resDet').textContent = <%- JSON.stringify(servicioSeleccionado) %> + ' · ' + duracion + ' min (hasta las ' + sl.fin + ')';
                                form.classList.add('activo');
                                pintarSlots();
                                form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                            }

                            grid.addEventListener('click', function (e) {
                                var b = e.target.closest('.cal-day.libre');
                                if (b) elegirDia(b.getAttribute('data-clave'));
                            });
                            slotGrid.addEventListener('click', function (e) {
                                var b = e.target.closest('.slot-chip');
                                if (b) elegirSlot(b.getAttribute('data-iso'));
                            });
                            prev.addEventListener('click', function () { mes = mes.m === 1 ? { y: mes.y - 1, m: 12 } : { y: mes.y, m: mes.m - 1 }; pintarMes(); });
                            next.addEventListener('click', function () { mes = mes.m === 12 ? { y: mes.y + 1, m: 1 } : { y: mes.y, m: mes.m + 1 }; pintarMes(); });
                            form.addEventListener('submit', function (e) {
                                if (!document.getElementById('inicioInput').value) { e.preventDefault(); }
                            });

                            elegirDia(datos.dias[0].clave);
                        })();
                        </script>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
    <%- include('../partials/modal-cambiar-password') %>
    <script>
        // Si hay horas esperando pago, se consulta el estado cada pocos segundos y
        // la página se recarga sola cuando cambia (p. ej. al confirmar el abono).
        <% var hayPendientes = misCitas.some(function (c) { return c.estado === 'pendiente_pago'; }); %>
        <% if (hayPendientes) { %>
        (function () {
            var inicial = <%- JSON.stringify(misCitas.map(function (c) { return c.id + ':' + c.estado + ':' + c.pago_estado; })) %>.join('|');
            function revisar() {
                fetch('/portal/agenda/estado', { credentials: 'same-origin', cache: 'no-store' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (estado) {
                        if (estado && estado.join('|') !== inicial) location.href = '/portal/agenda';
                    })
                    .catch(function () {});
            }
            setInterval(revisar, 8000);
            document.addEventListener('visibilitychange', function () { if (!document.hidden) revisar(); });
        })();
        <% } %>
        document.querySelectorAll('[data-expira]').forEach(function (el) {
            var fin = new Date(el.getAttribute('data-expira')).getTime();
            var t = el.querySelector('.tiempo');
            function tick() {
                var resta = Math.max(0, Math.round((fin - Date.now()) / 1000));
                t.textContent = Math.floor(resta / 60) + ':' + ('0' + (resta % 60)).slice(-2);
                if (resta <= 0) { clearInterval(iv); location.href = '/portal/agenda'; }
            }
            var iv = setInterval(tick, 1000);
            tick();
        });
        document.querySelectorAll('[data-copiar]').forEach(function (b) {
            b.addEventListener('click', function () {
                var t = b.getAttribute('data-copiar');
                var ok = function () { var o = b.textContent; b.textContent = '¡Copiado!'; setTimeout(function () { b.textContent = o; }, 1500); };
                if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(ok, function () {});
            });
        });
    </script>
</body>
</html>
