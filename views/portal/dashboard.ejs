<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Gestión | Tu Asesor Social</title>
    <meta name="robots" content="noindex, nofollow">
    <%- include('../partials/app-styles') %>
</head>
<body>
    <header class="app-header">
        <h1>Hola, <%= usuario.nombre %></h1>
        <a href="/portal/logout">Cerrar sesión</a>
    </header>
    <main class="app-main">
        <div class="card">
            <h2>Mis gestiones</h2>
            <% if (casos.length === 0) { %>
                <div class="empty-state">
                    Todavía no tienes una gestión registrada en el portal.
                    <br>Cuando tu trabajadora social cree tu caso, lo verás aquí.
                </div>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Tipo de gestión</th>
                            <th>Estado actual</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% casos.forEach(function (caso) { %>
                            <tr class="clickable" onclick="window.location.href='/portal/casos/<%= caso.id %>'">
                                <td><%= caso.tipo_subsidio %></td>
                                <td>
                                    <span class="badge<%= caso.estado_actual === 'Aprobado' ? ' badge-aprobado' : caso.estado_actual === 'Rechazado' ? ' badge-rechazado' : '' %>">
                                        <%= caso.estado_actual %>
                                    </span>
                                </td>
                                <td><a href="/portal/casos/<%= caso.id %>">Ver detalle &rarr;</a></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </main>
</body>
</html>
