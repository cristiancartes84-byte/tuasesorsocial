<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Gestión | Tu Asesor Social</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <%- include('../partials/app-styles') %>
    <%- include('../partials/dashboard-styles') %>
</head>
<body>
    <div class="app-shell">
        <%- include('../partials/portal-sidebar', { activo: 'dashboard' }) %>

        <div class="app-content">
            <div class="dash-header-row">
                <div class="dash-header">
                    <%- include('../partials/brand-mark', { dark: true }) %>
                    <div class="dash-date"><%= fechaHoy %></div>
                    <div class="dash-title">Hola, <%= usuario.nombre %></div>
                    <p class="dash-subtitle">Aquí puedes revisar el estado de tus gestiones con Tu Asesor Social.</p>
                </div>
                <div class="dash-header-actions">
                    <% if (trabajadorSocial) { %><%- include('../partials/portal-topbar') %><% } %>
                    <%- include('../partials/portal-mi-cuenta') %>
                </div>
            </div>

            <% if (pendientes.length > 0) { %>
                <div class="attention-banner">
                    <div class="attention-banner-title">⚠️ Necesita tu atención (<%= pendientes.length %>)</div>
                    <% pendientes.forEach(function (item) { %>
                        <div class="attention-item">
                            <span class="dot"></span>
                            <% if (item.tipo === 'documento') { %>
                                Falta subir <strong><%= item.texto %></strong> (<%= item.faltan %> pendiente<%= item.faltan > 1 ? 's' : '' %>) en <%= item.tipoSubsidio %>
                            <% } else { %>
                                Tienes una pregunta sin responder en <strong><%= item.tipoSubsidio %></strong>
                            <% } %>
                            <a href="/portal/casos/<%= item.casoId %>">Ver &rarr;</a>
                        </div>
                    <% }); %>
                </div>
            <% } %>

            <div class="stat-row">
                <div class="stat-card tone-blue">
                    <div>
                        <div class="stat-number"><%= stats.total %></div>
                        <div class="stat-label">Gestiones activas</div>
                    </div>
                </div>
                <div class="stat-card tone-orange">
                    <div>
                        <div class="stat-number"><%= stats.documentosPendientes %></div>
                        <div class="stat-label">Documentos pendientes</div>
                    </div>
                    <div class="stat-icon">📎</div>
                </div>
                <div class="stat-card tone-green">
                    <div>
                        <div class="stat-number"><%= stats.aprobadas %></div>
                        <div class="stat-label">Gestiones aprobadas</div>
                    </div>
                    <div class="stat-icon">✅</div>
                </div>
            </div>

            <div class="dash-grid">
                <div class="panel">
                    <div class="panel-header">
                        <h2>Tus gestiones</h2>
                        <span class="panel-count"><%= casos.length %> en total</span>
                    </div>

                    <% if (casos.length === 0) { %>
                        <div class="empty-state">
                            Todavía no tienes una gestión registrada en el portal.
                            <br>Cuando tu trabajadora social cree tu caso, lo verás aquí.
                        </div>
                    <% } else { %>
                        <% casos.forEach(function (caso) { %>
                            <div class="gestion-row">
                                <div class="gestion-avatar"><%= caso.icono %></div>
                                <div class="gestion-info">
                                    <strong><%= caso.tipo_subsidio %></strong>
                                    <span class="meta">Iniciada el <%= formatearFecha(caso.creado_en) %></span>
                                </div>
                                <div class="gestion-status">
                                    <span class="gestion-status-label">Hito actual</span>
                                    <span class="badge<%= caso.estado_actual === 'Aprobado' ? ' badge-aprobado' : caso.estado_actual === 'Rechazado' ? ' badge-rechazado' : '' %>">
                                        <%= caso.estado_actual %>
                                    </span>
                                    <a href="/portal/casos/<%= caso.id %>">Ver detalle &rarr;</a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <h2>Resumen</h2>
                    </div>

                    <% if (resumen.total === 0) { %>
                        <div class="donut-wrap">
                            <div class="donut" style="background: conic-gradient(#e2e8f0 0% 100%);">
                                <div class="donut-center"><span class="num">0</span><span class="label">Gestiones</span></div>
                            </div>
                        </div>
                    <% } else { %>
                        <% var pctProceso = Math.round((resumen.enProceso / resumen.total) * 100); %>
                        <% var pctAprobadas = Math.round((resumen.aprobadas / resumen.total) * 100); %>
                        <div class="donut-wrap">
                            <div class="donut" style="background: conic-gradient(#2563eb 0% <%= pctProceso %>%, #059669 <%= pctProceso %>% <%= pctProceso + pctAprobadas %>%, #dc2626 <%= pctProceso + pctAprobadas %>% 100%);">
                                <div class="donut-center"><span class="num"><%= resumen.total %></span><span class="label">Gestiones</span></div>
                            </div>
                        </div>
                    <% } %>

                    <div class="legend">
                        <div class="legend-item"><span class="legend-dot" style="background: #2563eb;"></span>En proceso<span class="legend-count"><%= resumen.enProceso %></span></div>
                        <div class="legend-item"><span class="legend-dot" style="background: #059669;"></span>Aprobadas<span class="legend-count"><%= resumen.aprobadas %></span></div>
                        <div class="legend-item"><span class="legend-dot" style="background: #dc2626;"></span>Rechazadas<span class="legend-count"><%= resumen.rechazadas %></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('../partials/modal-cambiar-password') %>
</body>
</html>
