<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Gestión | Tu Asesor Social</title>
    <meta name="robots" content="noindex, nofollow">
    <%- include('../partials/app-styles') %>
    <%- include('../partials/dashboard-styles') %>
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="app-sidebar-logo">
                <svg viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg" width="18" height="18"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </div>
            <nav class="app-sidebar-nav">
                <a href="/portal/dashboard" class="app-sidebar-link active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V9.5Z"/></svg>
                    <span class="app-sidebar-tooltip">Inicio</span>
                </a>
                <a href="https://wa.me/56949546000?text=Hola%2C%20necesito%20ayuda%20con%20mi%20gesti%C3%B3n" target="_blank" rel="noopener" class="app-sidebar-link whatsapp">
                    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    <span class="app-sidebar-tooltip">Contactar por WhatsApp</span>
                </a>
                <div class="app-sidebar-divider"></div>
                <a href="/cambiar-password" class="app-sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.5 12.5 19 4M19 4l2 2M16 7l2 2"/></svg>
                    <span class="app-sidebar-tooltip">Cambiar contraseña</span>
                </a>
            </nav>
            <a href="/portal/logout" class="app-sidebar-link app-sidebar-logout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
                <span class="app-sidebar-tooltip">Cerrar sesión</span>
            </a>
        </aside>

        <div class="app-content">
            <div class="dash-header">
                <div class="dash-date"><%= fechaHoy %></div>
                <div class="dash-title">Hola, <%= usuario.nombre %></div>
                <p class="dash-subtitle">Aquí puedes revisar el estado de tus gestiones con Tu Asesor Social.</p>
            </div>

            <% if (pendientes.length > 0) { %>
                <div class="attention-banner">
                    <div class="attention-banner-title">⚠️ Necesita tu atención (<%= pendientes.length %>)</div>
                    <% pendientes.forEach(function (item) { %>
                        <div class="attention-item">
                            <span class="dot"></span>
                            <% if (item.tipo === 'documento') { %>
                                Falta subir <strong><%= item.texto %></strong> (<%= item.faltan %> pendiente<%= item.faltan > 1 ? 's' : '' %>) en <%= item.tipoSubsidio %>
                            <% } else { %>
                                Tienes una pregunta sin responder en <strong><%= item.tipoSubsidio %></strong>
                            <% } %>
                            <a href="/portal/casos/<%= item.casoId %>">Ver &rarr;</a>
                        </div>
                    <% }); %>
                </div>
            <% } %>

            <div class="stat-row">
                <div class="stat-card tone-blue">
                    <div>
                        <div class="stat-number"><%= stats.total %></div>
                        <div class="stat-label">Gestiones activas</div>
                    </div>
                    <div class="stat-icon">📂</div>
                </div>
                <div class="stat-card tone-orange">
                    <div>
                        <div class="stat-number"><%= stats.documentosPendientes %></div>
                        <div class="stat-label">Documentos pendientes</div>
                    </div>
                    <div class="stat-icon">📎</div>
                </div>
                <div class="stat-card tone-green">
                    <div>
                        <div class="stat-number"><%= stats.aprobadas %></div>
                        <div class="stat-label">Gestiones aprobadas</div>
                    </div>
                    <div class="stat-icon">✅</div>
                </div>
            </div>

            <div class="dash-grid">
                <div class="panel">
                    <div class="panel-header">
                        <h2>Tus gestiones</h2>
                        <span class="panel-count"><%= casos.length %> en total</span>
                    </div>

                    <% if (casos.length === 0) { %>
                        <div class="empty-state">
                            Todavía no tienes una gestión registrada en el portal.
                            <br>Cuando tu trabajadora social cree tu caso, lo verás aquí.
                        </div>
                    <% } else { %>
                        <% casos.forEach(function (caso) { %>
                            <div class="gestion-row">
                                <div class="gestion-avatar"><%= caso.icono %></div>
                                <div class="gestion-info">
                                    <strong><%= caso.tipo_subsidio %></strong>
                                    <span class="meta">Iniciada el <%= caso.creado_en %></span>
                                </div>
                                <div class="gestion-status">
                                    <span class="badge<%= caso.estado_actual === 'Aprobado' ? ' badge-aprobado' : caso.estado_actual === 'Rechazado' ? ' badge-rechazado' : '' %>">
                                        <%= caso.estado_actual %>
                                    </span>
                                    <a href="/portal/casos/<%= caso.id %>">Ver detalle &rarr;</a>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <h2>Resumen</h2>
                    </div>

                    <% if (resumen.total === 0) { %>
                        <div class="donut-wrap">
                            <div class="donut" style="background: conic-gradient(#e2e8f0 0% 100%);">
                                <div class="donut-center"><span class="num">0</span><span class="label">Gestiones</span></div>
                            </div>
                        </div>
                    <% } else { %>
                        <% var pctProceso = Math.round((resumen.enProceso / resumen.total) * 100); %>
                        <% var pctAprobadas = Math.round((resumen.aprobadas / resumen.total) * 100); %>
                        <div class="donut-wrap">
                            <div class="donut" style="background: conic-gradient(#2563eb 0% <%= pctProceso %>%, #059669 <%= pctProceso %>% <%= pctProceso + pctAprobadas %>%, #dc2626 <%= pctProceso + pctAprobadas %>% 100%);">
                                <div class="donut-center"><span class="num"><%= resumen.total %></span><span class="label">Gestiones</span></div>
                            </div>
                        </div>
                    <% } %>

                    <div class="legend">
                        <div class="legend-item"><span class="legend-dot" style="background: #2563eb;"></span>En proceso<span class="legend-count"><%= resumen.enProceso %></span></div>
                        <div class="legend-item"><span class="legend-dot" style="background: #059669;"></span>Aprobadas<span class="legend-count"><%= resumen.aprobadas %></span></div>
                        <div class="legend-item"><span class="legend-dot" style="background: #dc2626;"></span>Rechazadas<span class="legend-count"><%= resumen.rechazadas %></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
